# ── Blockchain ──────────────────────────────────────────────────────────────
# Set NEXT_PUBLIC_CHAIN to "base" for mainnet, "base-sepolia" for testnet
NEXT_PUBLIC_CHAIN=base-sepolia

# RPC URLs (optional — public RPCs are used as fallback)
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Contract addresses — fill in after running `forge script Deploy`
NEXT_PUBLIC_REGISTRY_ADDRESS=0x
NEXT_PUBLIC_CONTENT_REGISTRY_ADDRESS=0x
NEXT_PUBLIC_SUBSCRIPTION_MANAGER_ADDRESS=0x
NEXT_PUBLIC_SPONSORSHIP_VAULT_ADDRESS=0x

# ── Storage ──────────────────────────────────────────────────────────────────
# Lighthouse.storage API key (server-side only — never NEXT_PUBLIC_)
LIGHTHOUSE_API_KEY=

# IPFS gateway for fetching content (can be any public gateway)
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.lighthouse.storage/ipfs

# ── Transcoding ───────────────────────────────────────────────────────────────
# Livepeer Studio API key (server-side only)
LIVEPEER_API_KEY=
